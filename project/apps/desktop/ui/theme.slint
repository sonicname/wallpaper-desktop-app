export global Theme {
    // Thumbnails are rounded against `background` in Rust, so both values must match.
    out property <color> background: #0f1013;
    out property <color> surface: #191b20;
    out property <color> raised: #24272e;
    out property <color> line: #2d3139;
    out property <color> text: #eef0f4;
    out property <color> muted: #949aa6;
    out property <color> accent: #f2b45c;
    out property <color> on-accent: #1b1306;
    out property <color> danger: #ff8f7a;
    out property <length> radius: 10px;
    out property <duration> quick: 120ms;
}
