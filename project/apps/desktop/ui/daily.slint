import { Option, Theme } from "theme.slint";
import { Button, Chip, Icon, IconButton, Icons, Switch } from "controls.slint";

export struct DailyState {
    enabled: bool,
    paused: bool,
    hour: string,
    status: string,
    problem: bool,
    autostart: bool,
    autostart-note: string,
    sources: [Option],
    sorts: [Option],
    categories: [Option],
}

component Caption inherits Text {
    color: Theme.muted;
    font-size: 12px;
    wrap: word-wrap;
}

component Heading inherits Text {
    color: Theme.text;
    font-size: 14px;
    font-weight: 600;
    wrap: word-wrap;
}

// Settings that belong together.
component Group inherits Rectangle {
    border-radius: 16px;
    border-width: 1px;
    border-color: #ffffff0f;
    background: #ffffff0a;
    VerticalLayout {
        padding: 16px;
        spacing: 16px;
        @children
    }
}

component Setting inherits HorizontalLayout {
    in property <string> title;
    in property <string> note;
    in property <bool> on;
    in property <bool> usable: true;
    callback toggled();
    spacing: 16px;

    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 3px;
        Heading {
            text: root.title;
            color: root.usable ? Theme.text : Theme.muted;
        }
        if root.note != "": Caption { text: root.note; }
    }
    VerticalLayout {
        alignment: start;
        Switch {
            label: root.title;
            checked: root.on;
            enabled: root.usable;
            activated => { root.toggled(); }
        }
    }
}

// Chips in two columns.
component Choices inherits Rectangle {
    in property <[Option]> options;
    in property <bool> quiet;
    callback picked(int);
    property <length> gap: 8px;
    property <length> column: (self.width - gap) / 2;
    height: ceil(options.length / 2) * (32px + gap) - gap;

    for option[i] in options: Chip {
        x: mod(i, 2) * (column + gap);
        y: floor(i / 2) * (32px + gap);
        width: column;
        text: option.label;
        quiet: root.quiet;
        checked: option.on;
        activated => { root.picked(i); }
    }
}

// A panel over the right side of the window.
export component DailyView inherits Rectangle {
    in property <DailyState> state;
    in property <bool> changing;
    in property <bool> open;
    property <length> panel: 392px;
    property <length> inset: 20px;
    property <length> shift: root.open ? 0px : 32px;
    animate shift { duration: 240ms; easing: ease-out; }
    callback close();
    callback toggle-enabled();
    callback toggle-paused();
    callback toggle-autostart();
    callback shift-hour(int);
    callback pick-source(int);
    callback pick-sort(int);
    callback pick-category(int);
    callback next();
    callback block();
    public function take-focus() { keys.focus(); }

    background: #000000b8;
    TouchArea {
        clicked => { root.close(); }
        scroll-event => { accept }
    }

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) { root.close(); return accept; }
            return reject;
        }
    }

    Rectangle {
        x: root.width - panel - inset + shift;
        y: inset;
        width: panel;
        height: root.height - 2 * inset;
        border-radius: 22px;
        border-width: 1px;
        border-color: #ffffff17;
        background: Theme.surface;
        TouchArea { scroll-event => { accept } }

        VerticalLayout {
            padding: 22px;
            spacing: 18px;

            HorizontalLayout {
                spacing: 12px;
                Rectangle {
                    width: 40px;
                    height: 40px;
                    border-radius: 12px;
                    background: Theme.accent-soft;
                    Icon { width: 18px; height: 18px; commands: Icons.sun; color: Theme.accent; }
                }
                Text {
                    text: "Mỗi ngày một hình nền";
                    color: Theme.text;
                    font-size: 18px;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                IconButton {
                    label: "Đóng";
                    commands: Icons.close;
                    activated => { root.close(); }
                }
            }

            Flickable {
                vertical-stretch: 1;
                min-height: 80px;
                content-height: settings.preferred-height;
                settings := VerticalLayout {
                    alignment: start;
                    spacing: 12px;

                    Group {
                        Setting {
                            title: "Tự đổi mỗi ngày";
                            note: "Khi bật, đóng cửa sổ thì app vẫn chạy dưới khay hệ thống.";
                            on: state.enabled;
                            toggled => { root.toggle-enabled(); }
                        }
                        if state.enabled: Setting {
                            title: "Tạm dừng";
                            on: state.paused;
                            toggled => { root.toggle-paused(); }
                        }
                        if state.enabled: HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 3px;
                                Heading { text: "Giờ đổi"; }
                                Caption { text: "Máy tắt lúc đó thì đổi khi mở lại."; }
                            }
                            VerticalLayout {
                                alignment: start;
                                Rectangle {
                                    width: 132px;
                                    height: 40px;
                                    border-radius: 13px;
                                    background: Theme.raised;
                                    HorizontalLayout {
                                        padding: 4px;
                                        IconButton {
                                            size: 32px;
                                            ghost: true;
                                            label: "Sớm hơn một giờ";
                                            commands: Icons.minus;
                                            activated => { root.shift-hour(-1); }
                                        }
                                        Text {
                                            text: state.hour;
                                            color: Theme.text;
                                            font-size: 15px;
                                            font-weight: 600;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                        IconButton {
                                            size: 32px;
                                            ghost: true;
                                            label: "Muộn hơn một giờ";
                                            commands: Icons.plus;
                                            activated => { root.shift-hour(1); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    Group {
                        Setting {
                            title: "Khởi động cùng Windows";
                            note: state.autostart-note;
                            usable: state.enabled || state.autostart;
                            on: state.autostart;
                            toggled => { root.toggle-autostart(); }
                        }
                    }
                    if state.enabled: Group {
                        if state.sources.length > 1: VerticalLayout {
                            spacing: 10px;
                            Heading { text: "Nguồn ảnh"; }
                            Choices {
                                options: state.sources;
                                picked(i) => { root.pick-source(i); }
                            }
                        }
                        if state.sorts.length > 1: VerticalLayout {
                            spacing: 10px;
                            Heading { text: "Ưu tiên"; }
                            Choices {
                                options: state.sorts;
                                picked(i) => { root.pick-sort(i); }
                            }
                        }
                        if state.categories.length > 1: VerticalLayout {
                            spacing: 10px;
                            Heading { text: "Danh mục"; }
                            Choices {
                                options: state.categories;
                                quiet: true;
                                picked(i) => { root.pick-category(i); }
                            }
                        }
                    }
                }
            }

            if state.enabled: VerticalLayout {
                spacing: 10px;
                HorizontalLayout {
                    spacing: 9px;
                    VerticalLayout {
                        padding-top: 6px;
                        alignment: start;
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: state.problem ? Theme.danger : state.paused ? Theme.faint : Theme.good;
                        }
                    }
                    Text {
                        text: state.status;
                        color: state.problem ? Theme.danger : Theme.muted;
                        font-size: 13px;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }
                Button {
                    text: changing ? "Đang đổi…" : "Đổi ngay";
                    primary: true;
                    enabled: !changing;
                    activated => { root.next(); }
                }
                Button {
                    text: "Không hiện lại ảnh này";
                    ghost: true;
                    enabled: !changing;
                    activated => { root.block(); }
                }
            }
        }
    }
}
