import { Option, Theme } from "theme.slint";

// Paths for a 16 by 16 box, drawn as outlines.
export global Icons {
    out property <string> search: "M 7 2 A 5 5 0 1 0 7 12 A 5 5 0 1 0 7 2 M 11 11 L 14.5 14.5";
    out property <string> close: "M 3.5 3.5 L 12.5 12.5 M 12.5 3.5 L 3.5 12.5";
    out property <string> left: "M 10 3 L 5 8 L 10 13";
    out property <string> right: "M 6 3 L 11 8 L 6 13";
    out property <string> minus: "M 3 8 L 13 8";
    out property <string> plus: "M 3 8 L 13 8 M 8 3 L 8 13";
    out property <string> heart: "M 8 14 C 2.5 10.2 1 7.4 1 5.2 C 1 3.1 2.6 1.6 4.6 1.6 C 6 1.6 7.2 2.4 8 3.6 C 8.8 2.4 10 1.6 11.4 1.6 C 13.4 1.6 15 3.1 15 5.2 C 15 7.4 13.5 10.2 8 14 Z";
    out property <string> compass: "M 8 1.5 A 6.5 6.5 0 1 0 8 14.5 A 6.5 6.5 0 1 0 8 1.5 Z M 10.8 5.2 L 9.2 9.2 L 5.2 10.8 L 6.8 6.8 Z";
    out property <string> folder: "M 1.5 12.5 L 1.5 3.5 L 6 3.5 L 7.5 5.5 L 14.5 5.5 L 14.5 12.5 Z";
    out property <string> sun: "M 8 5 A 3 3 0 1 0 8 11 A 3 3 0 1 0 8 5 Z M 8 1 L 8 2.6 M 8 13.4 L 8 15 M 1 8 L 2.6 8 M 13.4 8 L 15 8 M 3.05 3.05 L 4.2 4.2 M 11.8 11.8 L 12.95 12.95 M 3.05 12.95 L 4.2 11.8 M 11.8 4.2 L 12.95 3.05";
    out property <string> screen: "M 1.5 2.5 L 14.5 2.5 L 14.5 10.5 L 1.5 10.5 Z M 5.5 13.5 L 10.5 13.5 M 8 10.5 L 8 13.5";
    out property <string> link: "M 6.5 3.5 L 3 3.5 L 3 13 L 12.5 13 L 12.5 9.5 M 9.5 2.5 L 13.5 2.5 L 13.5 6.5 M 13.5 2.5 L 7.5 8.5";
    out property <string> undo: "M 5.5 3 L 2 6.5 L 5.5 10 M 2 6.5 L 10 6.5 A 3.5 3.5 0 0 1 10 13.5 L 7 13.5";
    out property <string> alert: "M 8 2 L 14.5 13.5 L 1.5 13.5 Z M 8 6.5 L 8 9.8 M 8 11.4 L 8 11.7";
    out property <string> picture: "M 2 3 L 14 3 L 14 13 L 2 13 Z M 2 11 L 5.5 7.5 L 8.5 10.5 L 10.5 8.5 L 14 12";
}

export component Icon inherits Path {
    in property <color> color: Theme.muted;
    in property <bool> filled;
    width: 16px;
    height: 16px;
    viewbox-width: 16;
    viewbox-height: 16;
    stroke: color;
    stroke-width: 1.5px;
    fill: filled ? color : transparent;
}

component Pressable inherits Rectangle {
    in property <bool> enabled: true;
    in property <string> label;
    in property <bool> checkable;
    in property <bool> checked;
    out property <bool> hovered: touch.has-hover && enabled;
    out property <bool> focused: focus.has-focus;
    callback activated();

    accessible-role: button;
    accessible-label: label;
    accessible-checkable: checkable;
    accessible-checked: checked;
    accessible-enabled: enabled;
    accessible-action-default => { if (enabled) { activated(); } }

    focus := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.activated();
                return accept;
            }
            return reject;
        }
    }

    @children

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.activated(); }
    }
}

// A place in the navigation rail.
export component RailItem inherits Pressable {
    in property <string> text;
    in property <string> commands;
    // A small mark for something that is switched on.
    in property <bool> dot;
    in property <color> dot-color: Theme.accent;
    label: text;
    checkable: true;
    width: 64px;
    height: 58px;
    border-radius: 14px;
    border-width: root.focused ? 1.5px : 0px;
    border-color: Theme.text;
    background: root.checked ? Theme.accent-soft : root.hovered ? Theme.raised : transparent;
    animate background { duration: Theme.quick; }

    Icon {
        y: 11px;
        width: 18px;
        height: 18px;
        commands: root.commands;
        color: root.checked ? Theme.accent : root.hovered ? Theme.text : Theme.muted;
    }
    Text {
        y: 35px;
        width: parent.width - 6px;
        text: root.text;
        color: root.checked ? Theme.text : Theme.muted;
        font-size: 11px;
        font-weight: root.checked ? 600 : 400;
        horizontal-alignment: center;
        overflow: elide;
    }
    if root.dot: Rectangle {
        x: 40px;
        y: 8px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: root.dot-color;
    }
}

export component Chip inherits Pressable {
    in property <string> text;
    // Filters that are usually on, so that they do not compete with the pictures.
    in property <bool> quiet;
    in property <string> icon;
    label: text;
    checkable: true;
    height: 32px;
    horizontal-stretch: 0;
    min-width: content.preferred-width + 26px;
    border-radius: 16px;
    border-width: 1px;
    border-color: root.focused ? Theme.text : !root.checked ? Theme.line : root.quiet ? Theme.hover : #f5b85f70;
    background: !root.checked ? (root.hovered ? Theme.surface : transparent) : root.quiet ? Theme.raised : Theme.accent-soft;
    animate background { duration: Theme.quick; }

    content := HorizontalLayout {
        alignment: center;
        spacing: 7px;
        if root.icon != "": VerticalLayout {
            alignment: center;
            Icon {
                width: 14px;
                height: 14px;
                commands: root.icon;
                color: caption.color;
            }
        }
        caption := Text {
            text: root.text;
            color: !root.checked ? Theme.muted : root.quiet ? Theme.text : Theme.accent;
            font-size: 13px;
            font-weight: root.checked && !root.quiet ? 600 : 400;
            vertical-alignment: center;
        }
    }
}

// A few choices of which one is always on.
export component Segmented inherits Rectangle {
    in property <[Option]> options;
    callback picked(int);
    height: 40px;
    horizontal-stretch: 0;
    border-radius: 13px;
    border-width: 1px;
    border-color: Theme.line;
    background: Theme.surface;

    HorizontalLayout {
        padding: 4px;
        spacing: 2px;
        for option[i] in root.options: Pressable {
            label: option.label;
            checkable: true;
            checked: option.on;
            min-width: caption.preferred-width + 26px;
            border-radius: 9px;
            border-width: self.focused ? 1.5px : 0px;
            border-color: Theme.text;
            background: option.on ? Theme.hover : self.hovered ? Theme.raised : transparent;
            animate background { duration: Theme.quick; }
            activated => { root.picked(i); }

            caption := Text {
                text: option.label;
                color: option.on ? Theme.text : Theme.muted;
                font-size: 13px;
                font-weight: option.on ? 600 : 400;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

export component Swatch inherits Pressable {
    in property <color> shade;
    checkable: true;
    width: 26px;
    height: 32px;

    Rectangle {
        width: root.checked ? 22px : root.hovered ? 20px : 16px;
        height: self.width;
        border-radius: self.width / 2;
        background: root.shade;
        border-width: root.checked || root.focused ? 2px : 1px;
        border-color: root.checked || root.focused ? Theme.text : #ffffff26;
        animate width { duration: Theme.quick; }
    }
}

export component Button inherits Pressable {
    in property <string> text;
    in property <string> icon;
    in property <bool> primary;
    in property <bool> small;
    // No background until the pointer is over it.
    in property <bool> ghost;
    label: text;
    // Next to other things it keeps its own width; in a column it still fills the row.
    horizontal-stretch: 0;
    height: root.small ? 32px : root.primary ? 46px : 40px;
    min-width: content.preferred-width + 28px;
    border-radius: root.small ? 10px : 13px;
    border-width: root.focused ? 2px : 0px;
    border-color: Theme.text;
    background: !root.enabled ? Theme.raised : root.primary ? (root.hovered ? Theme.accent.brighter(10%) : Theme.accent) : root.hovered ? Theme.hover : root.ghost ? transparent : Theme.raised;
    animate background { duration: Theme.quick; }

    content := HorizontalLayout {
        alignment: center;
        spacing: 8px;
        if root.icon != "": VerticalLayout {
            alignment: center;
            Icon {
                commands: root.icon;
                color: caption.color;
            }
        }
        caption := Text {
            text: root.text;
            color: !root.enabled ? Theme.faint : root.primary ? Theme.on-accent : Theme.text;
            font-size: root.small ? 13px : 14px;
            font-weight: root.small ? 500 : 600;
            vertical-alignment: center;
        }
    }
}

export component Switch inherits Pressable {
    checkable: true;
    width: 44px;
    height: 26px;
    border-radius: 13px;
    border-width: root.focused ? 2px : 0px;
    border-color: Theme.text;
    background: root.checked && root.enabled ? Theme.accent : Theme.hover;
    animate background { duration: Theme.quick; }

    Rectangle {
        x: root.checked ? parent.width - self.width - 4px : 4px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: root.checked && root.enabled ? Theme.on-accent : root.enabled ? Theme.text : Theme.faint;
        animate x { duration: Theme.quick; easing: ease-out; }
    }
}

export component IconButton inherits Pressable {
    in property <string> commands;
    // Drawn filled, in the accent colour.
    in property <bool> active;
    // For a place on top of a picture.
    in property <bool> glass;
    // No background until the pointer is over it.
    in property <bool> ghost;
    in property <length> size: 40px;
    width: size;
    height: size;
    border-radius: size / 2;
    border-width: root.focused ? 2px : 0px;
    border-color: Theme.text;
    background: root.hovered ? Theme.hover : root.glass ? Theme.glass : root.ghost ? transparent : Theme.raised;
    animate background { duration: Theme.quick; }

    Icon {
        commands: root.commands;
        filled: root.active;
        color: !root.enabled ? Theme.faint : root.active ? Theme.accent : Theme.text;
    }
}

export component SearchField inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text <=> input.text;
    callback submitted(string);

    height: 44px;
    border-radius: 14px;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.line;
    background: Theme.surface;
    animate border-color { duration: Theme.quick; }

    Icon {
        x: 16px;
        commands: Icons.search;
        color: input.has-focus ? Theme.text : Theme.muted;
    }

    if input.text == "": Text {
        x: 44px;
        width: parent.width - 60px;
        text: root.placeholder;
        color: Theme.faint;
        font-size: 14px;
        vertical-alignment: center;
        height: 100%;
        overflow: elide;
    }

    input := TextInput {
        x: 44px;
        width: parent.width - 84px;
        height: 100%;
        vertical-alignment: center;
        single-line: true;
        color: Theme.text;
        font-size: 14px;
        selection-background-color: Theme.accent;
        selection-foreground-color: Theme.on-accent;
        accessible-role: text-input;
        accessible-label: root.placeholder;
        accepted => { root.submitted(self.text); }
    }

    if input.text != "": TouchArea {
        x: parent.width - 38px;
        width: 30px;
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-label: "Xóa từ khóa";
        clicked => {
            input.text = "";
            root.submitted("");
        }
        Icon { commands: Icons.close; color: parent.has-hover ? Theme.text : Theme.muted; }
    }
}

// What is shown in place of pictures when there are none: why, and what to do about it.
export component Notice inherits VerticalLayout {
    in property <string> icon;
    in property <string> title;
    in property <string> text;
    in property <bool> problem;
    alignment: center;
    spacing: 14px;

    HorizontalLayout {
        alignment: center;
        Rectangle {
            width: 64px;
            height: 64px;
            border-radius: 32px;
            background: root.problem ? #ff8a751f : Theme.surface;
            border-width: 1px;
            border-color: root.problem ? #ff8a7540 : Theme.line;
            Icon {
                width: 24px;
                height: 24px;
                commands: root.icon;
                color: root.problem ? Theme.danger : Theme.muted;
            }
        }
    }
    if root.title != "": Text {
        text: root.title;
        color: Theme.text;
        font-size: 18px;
        font-weight: 600;
        horizontal-alignment: center;
    }
    HorizontalLayout {
        alignment: center;
        Text {
            max-width: 460px;
            text: root.text;
            color: root.title == "" ? Theme.text : Theme.muted;
            font-size: root.title == "" ? 15px : 14px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
    @children
}
