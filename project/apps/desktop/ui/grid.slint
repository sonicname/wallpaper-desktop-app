import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icon, Icons } from "controls.slint";

export struct Cell {
    index: int,
    x: length,
    width: length,
    image: image,
    ready: bool,
    tint: color,
    label: string,
    favorite: bool,
}

export struct Row {
    height: length,
    cells: [Cell],
}

component CellView inherits Rectangle {
    in property <Cell> cell;
    in property <bool> can-favorite;
    in property <bool> can-apply;
    callback activated();
    callback favorite();
    callback apply();
    // The buttons are inside the area, so that it stays hovered while the pointer is on them.
    property <bool> hovering: touch.has-hover;
    property <bool> wide: root.width >= 170px;

    accessible-role: button;
    accessible-label: "Hình nền " + cell.label;
    accessible-action-default => { activated(); }

    if !cell.ready: Rectangle {
        border-radius: Theme.radius;
        background: cell.tint;
    }
    // The picture already has the size and rounded corners of the cell.
    if cell.ready: Image {
        width: 100%;
        height: 100%;
        source: cell.image;
        image-fit: fill;
    }
    if hovering: Rectangle {
        y: parent.height - self.height;
        height: min(parent.height, 84px);
        background: @linear-gradient(180deg, #00000000 0%, #000000c4 100%);
    }
    if hovering: Rectangle {
        border-radius: Theme.radius;
        border-width: 1.5px;
        border-color: #ffffff66;
    }
    if hovering: Text {
        x: 14px;
        y: parent.height - self.height - 14px;
        text: cell.label;
        color: Theme.text;
        font-size: 12px;
        font-weight: 500;
    }
    if cell.favorite || (hovering && can-favorite): Rectangle {
        x: parent.width - self.width - 10px;
        y: 10px;
        width: 30px;
        height: 30px;
        border-radius: 15px;
        background: like.has-hover ? Theme.hover : Theme.glass;
        Icon {
            commands: Icons.heart;
            color: cell.favorite ? Theme.accent : Theme.text;
            filled: cell.favorite;
        }
    }
    if hovering && can-apply && wide: Rectangle {
        x: parent.width - self.width - 10px;
        y: parent.height - self.height - 10px;
        width: 116px;
        height: 30px;
        border-radius: 15px;
        background: set.has-hover ? Theme.accent.brighter(10%) : Theme.accent;
        HorizontalLayout {
            alignment: center;
            spacing: 6px;
            VerticalLayout {
                alignment: center;
                Icon {
                    width: 13px;
                    height: 13px;
                    commands: Icons.screen;
                    color: Theme.on-accent;
                }
            }
            Text {
                text: "Đặt làm nền";
                color: Theme.on-accent;
                font-size: 12px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }

        like := TouchArea {
            x: parent.width - self.width - 10px;
            y: 10px;
            width: 30px;
            height: 30px;
            enabled: can-favorite;
            mouse-cursor: pointer;
            accessible-role: button;
            accessible-label: cell.favorite ? "Bỏ khỏi yêu thích" : "Thêm vào yêu thích";
            clicked => { root.favorite(); }
        }
        set := TouchArea {
            x: parent.width - self.width - 10px;
            y: parent.height - self.height - 10px;
            width: 116px;
            height: 30px;
            enabled: can-apply && wide;
            mouse-cursor: pointer;
            accessible-role: button;
            accessible-label: "Đặt làm hình nền";
            clicked => { root.apply(); }
        }
    }
}

export component Grid inherits Rectangle {
    in property <[Row]> rows;
    in property <length> gap;
    in property <bool> busy;
    in property <bool> can-favorite;
    in property <bool> can-apply;
    in-out property <length> scroll <=> list.content-y;
    out property <length> inner-width: list.visible-width - 16px;
    callback activated(int);
    callback favorite(int);
    callback apply(int);

    list := ListView {
        for row in root.rows: Rectangle {
            height: row.height + root.gap;
            for cell in row.cells: CellView {
                x: cell.x;
                y: 0;
                width: cell.width;
                height: row.height;
                cell: cell;
                can-favorite: root.can-favorite;
                can-apply: root.can-apply;
                activated => { root.activated(cell.index); }
                favorite => { root.favorite(cell.index); }
                apply => { root.apply(cell.index); }
            }
        }
    }

    if root.busy: Rectangle {
        property <float> phase: mod(animation-tick(), 1200ms) / 1200ms;
        y: 0;
        x: -self.width + (parent.width + self.width) * phase;
        width: parent.width * 30%;
        height: 2px;
        border-radius: 1px;
        background: Theme.accent;
    }
}
